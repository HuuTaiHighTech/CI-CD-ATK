{
  "name": "atk",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "admin",
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,admin,web -c blue,green,magenta \"npm run dev:api\" \"npm run dev:admin\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=api",
    "build:admin": "npm run build --workspace=admin",
    "build:web": "npm run build --workspace=web",
    "start": "concurrently -n api,admin,web -c blue,green,magenta \"npm run start:api\" \"npm run start:admin\" \"npm run start:web\"",
    "start:api": "npm run start --workspace=api",
    "start:admin": "npm run start --workspace=admin",
    "start:web": "npm run start --workspace=web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=api",
    "prisma:generate": "npm run prisma:generate --workspace=api",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace=api",
    "prisma:migrate": "npm run prisma:migrate --workspace=api",
    "prisma:seed": "npm run prisma:seed --workspace=api",
    "prisma:reset": "npm run prisma:reset --workspace=api",
    "prisma:studio": "npm run prisma:studio --workspace=api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
